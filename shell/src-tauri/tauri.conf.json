{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-rescue",
  "version": "0.1.0",
  "identifier": "app.dshrescue.shell",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "dsh-rescue 插件修复台",
        "width": 1040,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
